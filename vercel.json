{
    "version": 2,
    "framework": null,
    "buildCommand": "cd enverga-pass && npm install && npm run build",
    "outputDirectory": "enverga-pass/public",
    "functions": {
        "enverga-pass/api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/enverga-pass/public/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/enverga-pass/public/images/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/enverga-pass/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/enverga-pass/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/enverga-pass/api/index.php"
        }
    ]
}
